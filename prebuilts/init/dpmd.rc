# The stock dpmd.rc, with one added line: libdpmframework.so still imports
# strdup8to16, Android 11 dropped it from libcutils, and the blob's DT_NEEDED list
# cannot be extended in place, so the compat library is preloaded. Note that
# Android 11's setenv takes exactly two arguments - the stock environment line
# aborts the parse of the whole file and init drops the service.
service dpmd /system/bin/dpmd
    class late_start
    setenv LD_PRELOAD /system/lib64/libdpmcompat.so
    socket dpmd stream 660 root system
    socket tcm  stream 660 root inet
    socket dpmwrapper stream 660 root inet
    group system readproc inet radio wakelock oem_2901
