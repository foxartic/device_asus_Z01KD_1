# Lineage additions to the stock init.qcom.rc.
#
# init.rc imports BOTH /init.qcom.rc (stock copy) and
# /vendor/etc/init/hw/init.qcom.rc (this file), and Android init does not
# deduplicate actions.  The stock body must NOT be repeated here: doing so
# registers every action twice, so `on fs` runs twice and the second
# mount_all over-mounts a tmpfs on the already-mounted /data.

# Lineage: load qca_cld3 WLAN driver (stock HAL would insmod this itself)
on boot
    insmod /system/lib/modules/qca_cld3/qca_cld3_wlan.ko

# WIFI chain: peripheral manager, verbatim from stock init.target.rc.
# cnss-daemon blocks at startup waiting for vendor.qcom.PeripheralManager;
# without it the WLFW QMI service never starts -> no firmware -> no wlan0.
service per_mgr /system/vendor/bin/pm-service
    class core
    user system
    group system
    ioprio rt 4
    capabilities NET_BIND_SERVICE NET_RAW

service per_proxy /system/vendor/bin/pm-proxy
    class core
    user system
    group system
    disabled

on property:init.svc.per_mgr=running
    start per_proxy

on property:sys.shutdown.requested=*
    stop per_proxy

# Mirror stock init.target.rc: mark the driver loaded after insmod.
on boot
    setprop wlan.driver.status "ok"

# Stock init.target.rc daemons that our system does not ship.
service thermal-engine /system/vendor/bin/thermal-engine
   class main
   user root
   socket thermal-send-client stream 0666 system system
   socket thermal-recv-client stream 0660 system system
   socket thermal-recv-passive-client stream 0666 system system
   socket thermal-send-rule stream 0660 system system
   group root

service adsprpcd /system/vendor/bin/adsprpcd audiopd
   class main
   user media
   group media

service pd_mapper /system/vendor/bin/pd-mapper
     class core

service hvdcp_opti /system/vendor/bin/hvdcp_opti
     class main
     user root
     group system wakelock

service energy-awareness /system/vendor/bin/energy-awareness
    class main
    user system
    group system
    oneshot
import /vendor/etc/init/hw/init.asus.rc
