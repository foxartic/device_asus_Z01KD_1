cc_library_shared {
    name: "libdpmcompat",
    srcs: [
        "strdup8to16.cpp",
        "strdup16to8.cpp",
    ],
    compile_multilib: "both",
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

// qcrilmsgtunnel (an 8.0-era Qualcomm APK) resolves android.hidl.base.V1_0.IBase
// from the boot classpath, which Android 8.x shipped and Android 11 exposes only
// through <uses-library>. A device-owned name keeps the boot-jar slot out of the
// apex lookup, because soong resolves the real module names into the updatable
// com.android.wifi / com.android.tethering apexes and refuses them as boot jars.
java_library {
    name: "device-hidl-java-compat",
    installable: true,
    sdk_version: "system_current",

    static_libs: [
        "android.hidl.base-V1.0-java",
        "android.hidl.manager-V1.0-java",
    ],
}
