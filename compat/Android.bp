cc_library_shared {
    name: "libdpmcompat",
    srcs: [
        "strdup8to16.cpp",
        "strdup16to8.cpp",
    ],
    compile_multilib: "both",
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

// qcrilmsgtunnel (an 8.0-era Qualcomm APK) resolves android.hidl.base.V1_0.IBase
// through the boot classpath, which Android 8.x shipped and Android 11 does
// not: A11 only exposes those jars through <library> entries, and the APK declares
// no <uses-library>, so the classes stay invisible to it. They cannot simply be put
// back on PRODUCT_BOOT_JARS under their own names, because soong resolves those
// module names into the updatable com.android.wifi / com.android.tethering apexes
// and refuses them as framework boot jars (build/soong/java/dexpreopt_bootjars.go).
// A device-owned java_library that merges the two stub jars keeps the boot-jar slot
// out of that apex lookup; the same static_libs pair is what
// vendor/codeaurora/telephony/qti-hidl-wrapper uses for its system_ext library.
java_library {
    name: "device-hidl-java-compat",
    installable: true,
    sdk_version: "system_current",

    static_libs: [
        "android.hidl.base-V1.0-java",
        "android.hidl.manager-V1.0-java",
    ],
}
